{
  "name": "08-user-store",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "tsnd --respawn --clear src/app.ts",
    "build": "rimraf ./dist && tsc",
    "start": "npm run build && node dist/app.js",
    "migrate:make": "npx knex migrate:make --knexfile src/data/postgres/knexfile.ts --env development",
    "migrate:latest": "npx knex migrate:latest --knexfile src/data/postgres/knexfile.ts --env development",
    "perf:seed": "node performance/scripts/seed-perf-data.js",
    "perf:reset": "node performance/scripts/reset-perf-data.js",
    "perf:clean": "./performance/scripts/clean-results.sh",
    "perf:smoke": "node performance/scripts/run-performance.js k6 00-smoke",
    "perf:k6": "node performance/scripts/run-performance.js k6",
    "perf:gatling": "node performance/scripts/run-performance.js gatling",
    "test": "npm run build && node --test performance/tests/*.test.js",
    "perf:report": "node performance/scripts/generate-report.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/express": "^4.17.18",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.8.0",
    "@types/nodemailer": "^7.0.2",
    "@types/pg": "^8.15.5",
    "newman": "^6.2.3",
    "newman-reporter-htmlextra": "^1.23.1",
    "rimraf": "^5.0.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "dotenv": "^16.3.1",
    "env-var": "^7.4.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "nodemailer": "^7.0.9",
    "pg": "^8.16.3"
  }
}
