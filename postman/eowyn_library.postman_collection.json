        {
          "name": "create loan",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const fecha = new Date();\r\nfecha.setDate(fecha.getDate() + 7);\r\n\r\npm.environment.set(\"dueDate\", fecha.toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {\r\n    pm.environment.set(\"loanId\", pm.response.json().id);\r\n}\r\n\r\npm.test(\"Prestamo creado correctamente\", function () {\r\n    pm.response.to.have.status(201);\r\n\r\n    const data = pm.response.json();\r\n\r\n    pm.expect(data.status).to.eql(\"ongoing\");\r\n    pm.expect(Number(data.userId))\r\n        .to.eql(Number(pm.environment.get(\"userId\")));\r\n    pm.expect(Number(data.bookId))\r\n        .to.eql(Number(pm.environment.get(\"bookId\")));\r\n});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
